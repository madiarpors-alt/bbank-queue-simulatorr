flowchart TD
    A(["insertAVL(node, p)"]) --> B{"node == null?"}
    B -- "Иә" --> C["Жаңа түйін жасап қайтару"]
    B -- "Жоқ" --> D{"p.name node.name-мен салыстыру"}
    D -- "Кіші" --> E["Солға рекурсивті қосу"]
    D -- "Үлкен" --> F["Оңға рекурсивті қосу"]
    D -- "Тең" --> G["node қайтару (қайталануға жол жоқ)"]
    E --> H["Биіктікті жаңарту"]
    F --> H
    H --> I["Баланс = h(left) - h(right)"]
    I --> J{"Баланс > 1?"}
    J -- "Иә" --> K{"Сол баланың солына қосылды ма?"}
    K -- "Иә" --> L["LL: rightRotate(node)"]
    K -- "Жоқ" --> M["LR: leftRotate(left), сосын rightRotate(node)"]
    J -- "Жоқ" --> N{"Баланс < -1?"}
    N -- "Иә" --> O{"Оң баланың оңына қосылды ма?"}
    O -- "Иә" --> P["RR: leftRotate(node)"]
    O -- "Жоқ" --> Q["RL: rightRotate(right), сосын leftRotate(node)"]
    N -- "Жоқ" --> R["Өзгеріссіз node қайтару"]
