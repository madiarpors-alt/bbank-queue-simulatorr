flowchart TD
    A(["Бастау"]) --> B[/"Пациент деректерін енгізу: ID, аты, приоритет, диагноз"/]
    B --> C["Patient объектісін құру"]
    C --> D["Байланысты тізімге қосу, O(1)"]
    D --> E["Стекке қосу (undo үшін), O(1)"]
    E --> F["Хэш-таблицаға қосу, O(1) орташа"]
    F --> G["BST және AVL ағашына қосу, O(log n)"]
    G --> H["Приоритет кезегіне push (heap), O(log n)"]
    H --> I{"Тағы пациент бар ма?"}
    I -- "Иә" --> B
    I -- "Жоқ" --> J{"Undo керек пе?"}
    J -- "Иә" --> K["Стектен соңғы пациентті алу, тізімнен өшіру"]
    K --> L
    J -- "Жоқ" --> L{"Приоритет кезегі бос па?"}
    L -- "Жоқ" --> M["Ең ауыр пациентті pop (heap), O(log n)"]
    M --> N["Пациентті қабылдау, нәтижені шығару"]
    N --> L
    L -- "Иә" --> O["Статистика мен Big-O қорытындысын шығару"]
    O --> P(["Соңы"])
